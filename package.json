{
  "name": "@ohunkohun/nomba-sdk",
  "version": "1.0.0",
  "description": "A TypeScript SDK for the Nomba API",
  "scripts": {
    "dev": "tsx watch src/examples/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "types:watch": "npx tsc --noEmit --watch",
    "pack:dry": "npm pack --dry-run",
    "pack": "npm pack",
    "patch": "npm version patch",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "nomba",
    "sdk",
    "typescript",
    "javascript",
    "node",
    "js",
    "ts"
  ],
  "author": "Ohunkóhun",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
